root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
ij_java_continuation_indent_size = 4
max_line_length = off
ij_java_right_margin = 9999

[*.xml]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,js,vue,css}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4
